// Cloudflare Worker: static files from this folder, /api/* handled by worker.js.
// Secrets: Worker → Settings → Variables and Secrets → ANTHROPIC_API_KEY (Secret), ALLOWED_ORIGINS (Text).
{
  "name": "lixr-app",
  "main": "worker.js",
  "compatibility_date": "2025-06-01",
  // Keep variables set in the Cloudflare dashboard when deploying from GitHub.
  "keep_vars": true,
  "assets": { "directory": "./", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "observability": { "enabled": true }
}
